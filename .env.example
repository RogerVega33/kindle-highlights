# Plantilla para crear .env

PGDATABASE=kindle_highlights
PGUSER=kindle_highlights_user
PGPASSWORD='REEMPLAZAR_POR_UNA_CONTRASENA_SEGURA'

# Solo para HTTPS con proxy inverso: descomenta y sustituye por la IP exacta desde la que el proxy llega al contenedor.
# TRUSTED_PROXY_IP=192.0.2.10

# Para desarrollo levantando el servidor fuera de docker utiliza también estas variables
# PGHOST=127.0.0.1
# PGPORT=5432
